# =============================================================================
# ChefboxAI Environment Configuration
# =============================================================================
# This file contains configuration for both Development and Production environments.
# Copy the appropriate section to your local .env file based on your environment.
#
# Usage:
#   - For Development: Copy the DEVELOPMENT section values
#   - For Production:  Copy the PRODUCTION section values
#
# IMPORTANT: Never commit actual .env files with real credentials to version control!
# =============================================================================

# =============================================================================
# SHARED CONFIGURATION (Common to both environments)
# =============================================================================
NODE_ENV=development                    # 'development' or 'production'
API_PREFIX=api
JSON_LIMIT=10mb

# =============================================================================
# DEVELOPMENT ENVIRONMENT
# =============================================================================
# Database - Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chefboxai_dev
DB_USER=postgres
DB_PASS=your_local_password

# JWT Configuration
JWT_SECRET=dev_jwt_secret_key_change_in_production_123456789
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# App Configuration
PORT=4000
BASE_URL=http://localhost:4000
ENVIRONMENT_API_URL=http://localhost:4000/api
HOST_IP=localhost

# Security
RATE_LIMIT_WINDOW_MS=900000            # 15 minutes
RATE_LIMIT_MAX=100
RATE_LIMIT_MESSAGE=Too many requests from this IP
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true
OTP_EXPIRY_MINUTES=10

# Razorpay (Use test keys for development)
RZP_KEY_ID=rzp_test_your_test_key_id
RZP_KEY_SECRET=your_test_key_secret
RZP_WEBHOOK_SECRET=your_webhook_secret

# Swagger/Docs
ENABLE_DOCS=true
SWAGGER_USER=admin
SWAGGER_PASS=chefbox123

# Email (Use Gmail SMTP or Mailtrap for development)
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=ChefboxAI <noreply@chefboxai.com>

# SendGrid (Alternative email provider)
SENDGRID_API_KEY=your_sendgrid_api_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_ALLOWED_AUDIENCES=your_google_client_id

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key

# PostgreSQL SSL (Disable for local development)
ENVIRONMENT_PG_SSL=false

# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
# Database - Production PostgreSQL (Supabase/Contabo/Railway)
# DB_HOST=your_production_host.supabase.co
# DB_PORT=5432
# DB_NAME=prod_chefboxai
# DB_USER=postgres
# DB_PASS=your_strong_production_password

# JWT Configuration - Use strong secrets!
# JWT_SECRET=your_very_long_random_secret_key_min_32_chars_abc123xyz
# ACCESS_TOKEN_EXPIRES_IN=1h
# REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# App Configuration
# PORT=4000
# BASE_URL=https://chefboxai.yourdomain.com
# ENVIRONMENT_API_URL=https://chefboxai.yourdomain.com/api
# HOST_IP=your_server_ip

# Security - Stricter rate limiting for production
# RATE_LIMIT_WINDOW_MS=900000            # 15 minutes
# RATE_LIMIT_MAX=50                      # Reduced from dev
# RATE_LIMIT_MESSAGE=Too many requests from this IP, please try again later
# CORS_ORIGIN=https://chefboxai.yourdomain.com,https://admin.chefboxai.yourdomain.com
# CORS_CREDENTIALS=true
# OTP_EXPIRY_MINUTES=5                   # Reduced for security

# Razorpay (Use live keys for production)
# RZP_KEY_ID=rzp_live_your_live_key_id
# RZP_KEY_SECRET=your_live_key_secret
# RZP_WEBHOOK_SECRET=your_production_webhook_secret

# Swagger/Docs - Disable in production!
# ENABLE_DOCS=false
# SWAGGER_USER=admin
# SWAGGER_PASS=change_this_strong_password

# Email (Production SMTP)
# EMAIL_ENABLED=true
# EMAIL_PROVIDER=smtp
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=prod_email@yourdomain.com
# EMAIL_PASS=your_strong_email_password
# EMAIL_FROM=ChefboxAI <noreply@chefboxai.com>

# SendGrid (Production)
# SENDGRID_API_KEY=SG.your_production_sendgrid_key

# Google OAuth (Production)
# GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
# GOOGLE_ALLOWED_AUDIENCES=your_production_google_client_id

# Groq AI (Production)
# GROQ_API_KEY=gsk_your_production_groq_api_key

# PostgreSQL SSL (Enable for production!)
# ENVIRONMENT_PG_SSL=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# LOG_FILE_PATH=./logs                    # Directory for log files
# LOG_MAX_FILES=30                        # Keep logs for 30 days
# LOG_MAX_SIZE=20m                        # Max size per log file